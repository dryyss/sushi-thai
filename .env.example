# Base de données PostgreSQL (Neon ou Vercel Postgres)
DATABASE_URI=postgres://user:password@host:5432/sushi_thai

# Payload CMS (chaîne aléatoire longue)
PAYLOAD_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# E-mails (Resend)
RESEND_API_KEY=
EMAIL_FROM="Sushi Thaï <commande@example.com>"
RESTAURANT_EMAIL=

# URL publique du site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Formule vendue et fonctionnalités (voir src/config/features.ts)
# SITE_PLAN : essentiel | pro | premium
SITE_PLAN=pro
# Clés séparées par des virgules, pour activer ou couper une fonctionnalité à la carte
# ex. FEATURES_ON=promoCodes,club   FEATURES_OFF=reservations
FEATURES_ON=
FEATURES_OFF=
